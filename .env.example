# Database (PostgreSQL — Neon, Supabase, or PlanetScale)
# REQUIRED. Never commit a real DATABASE_URL — a previous committed value
# must be rotated in Neon (see the PR description for fix/critical-security).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"

# JWT Secret — REQUIRED. Generate with: openssl rand -base64 32
# Must be at least 32 characters. Auth fails loudly if this is missing.
JWT_SECRET="REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARS"

# Twilio (SMS one-time codes) — REQUIRED for login.
# Sign up at twilio.com. Login returns 503 until these are set.
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="REPLACE_WITH_TWILIO_AUTH_TOKEN"
TWILIO_PHONE_NUMBER="+1234567890"

# Cloudinary (for image uploads — sign up at cloudinary.com)
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="REPLACE_WITH_CLOUDINARY_API_KEY"
CLOUDINARY_API_SECRET="REPLACE_WITH_CLOUDINARY_API_SECRET"
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"

# Exchange Rates (https://exchangeratesapi.io — free tier)
EXCHANGE_RATES_API_KEY="REPLACE_WITH_EXCHANGE_RATES_API_KEY"

# Upstash Redis (rate limiting) — REQUIRED in production.
# Without these the app falls back to in-memory limits, which reset on
# every serverless cold start and are not shared across instances.
UPSTASH_REDIS_REST_URL="https://REPLACE_WITH_UPSTASH_REST_URL"
UPSTASH_REDIS_REST_TOKEN="REPLACE_WITH_UPSTASH_REST_TOKEN"

# App Config
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Community Food Exchange"
