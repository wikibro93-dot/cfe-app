// Prisma 7 schema — url is NOT in the schema, it goes in prisma.config.ts

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String   @id @default(cuid())
  // Phone is optional now: social sign-in (Google/Facebook) has no phone
  // number. Legacy phone accounts keep their number; new accounts leave
  // it null until the user adds one in their profile.
  phone           String?  @unique
  // Email from the social provider (verified by Google/Facebook), used to
  // link one person's Google and Facebook sign-ins to a single account.
  email           String?  @unique
  // Firebase Auth user id, set on social sign-in.
  firebaseUid     String?  @unique
  authProvider    AuthProvider?
  name            String
  avatar          String?
  bio             String?
  role            Role     @default(COOK)
  credits         Float    @default(10)
  latitude        Float?
  longitude       Float?
  city            String?
  country         String?
  currency        String   @default("USD")
  language        String   @default("en")
  timezone        String   @default("UTC")
  isVerified      Boolean  @default(false)
  isVerifiedCook  Boolean  @default(false)
  badges          String[] @default([])
  totalSwaps      Int      @default(0)
  totalDishes     Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  dishes          Dish[]
  swapsAsBuyer    Swap[]             @relation("BuyerSwaps")
  swapsAsCook     Swap[]             @relation("CookSwaps")
  otps            OTP[]
  creditTx        CreditTransaction[]
  ratings         Rating[]           @relation("RatingsGiven")
  receivedRatings Rating[]           @relation("RatingsReceived")
  notifications   Notification[]
  chatMessages    ChatMessage[]
}

model OTP {
  id        String   @id @default(cuid())
  phone     String
  // SHA-256 hash of the 6-digit code — the plain code is NEVER stored.
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  // Failed verification attempts; the code is invalidated at 5.
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])
  userId    String?

  @@index([phone, used, expiresAt])
}

model Dish {
  id           String       @id @default(cuid())
  title        String
  description  String?
  ingredients  String[]
  category     DishCategory
  image        String?
  servings     Int
  quantity     String
  unit         String       @default("servings")
  priceCredits Float        @default(0)
  priceMoney   Float?
  currency     String?
  status       DishStatus   @default(AVAILABLE)
  pickupFrom   DateTime
  pickupTo     DateTime
  latitude     Float
  longitude    Float
  address      String?
  city         String
  country      String
  isSwappable  Boolean      @default(true)
  isFree       Boolean      @default(false)
  tags         String[]     @default([])
  viewCount    Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  cook         User         @relation(fields: [cookId], references: [id])
  cookId       String
  swaps        Swap[]
  ratings      Rating[]

  @@index([cookId, status])
  @@index([status, pickupTo])
}

model Swap {
  id           String     @id @default(cuid())
  type         SwapType
  status       SwapStatus @default(PENDING)
  creditAmount Float      @default(0)
  moneyAmount  Float?
  currency     String?
  message      String?
  confirmedAt  DateTime?
  pickedUpAt   DateTime?
  cancelledAt  DateTime?
  cancelReason String?
  // Latest buyer location, updated by POST /api/swaps/[id]/location.
  // Socket.IO live push was removed, so the cook polls GET on this route
  // instead (see app/swaps/[id]/track/page.tsx). Nullable — no location
  // has been shared yet until the buyer broadcasts.
  buyerLat       Float?
  buyerLng       Float?
  buyerLocationAt DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  dish         Dish         @relation(fields: [dishId], references: [id])
  dishId       String
  buyer        User         @relation("BuyerSwaps", fields: [buyerId], references: [id])
  buyerId      String
  cook         User         @relation("CookSwaps", fields: [cookId], references: [id])
  cookId       String
  rating       Rating?
  notification Notification[]
  chatMessages ChatMessage[]

  @@index([buyerId, status])
  @@index([cookId, status])
  @@index([dishId, status])
}

model CreditTransaction {
  id            String     @id @default(cuid())
  amount        Float
  type          CreditType
  description   String
  balanceBefore Float
  balanceAfter  Float
  swapId        String?
  createdAt     DateTime   @default(now())

  user   User   @relation(fields: [userId], references: [id])
  userId String

  @@index([userId, createdAt])
}

model Rating {
  id        String   @id @default(cuid())
  score     Int
  comment   String?
  createdAt DateTime @default(now())

  rater   User   @relation("RatingsGiven", fields: [raterId], references: [id])
  raterId String
  rated   User   @relation("RatingsReceived", fields: [ratedId], references: [id])
  ratedId String
  dish    Dish?  @relation(fields: [dishId], references: [id])
  dishId  String?
  swap    Swap?  @relation(fields: [swapId], references: [id])
  swapId  String? @unique
}

model Notification {
  id        String   @id @default(cuid())
  type      String
  title     String
  body      String
  data      Json?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  userId String
  swap   Swap?  @relation(fields: [swapId], references: [id])
  swapId String?

  @@index([userId, read])
}

model ChatMessage {
  id        String   @id @default(cuid())
  text      String
  createdAt DateTime @default(now())

  swap     Swap   @relation(fields: [swapId], references: [id])
  swapId   String
  sender   User   @relation(fields: [senderId], references: [id])
  senderId String

  @@index([swapId, createdAt])
}

enum Role {
  COOK
  BUYER
  MODERATOR
  ADMIN
}

enum AuthProvider {
  PHONE
  GOOGLE
  FACEBOOK
}

enum DishStatus {
  AVAILABLE
  RESERVED
  PICKED_UP
  COMPLETED
  CANCELLED
  EXPIRED
}

enum DishCategory {
  MAIN_COURSE
  APPETIZER
  DESSERT
  BREAKFAST
  SNACK
  BEVERAGE
  BAKED_GOODS
  SOUP
  SALAD
  OTHER
}

enum SwapType {
  DIRECT
  CREDITS
  FREE
  MONEY
}

enum SwapStatus {
  PENDING
  CONFIRMED
  PICKED_UP
  COMPLETED
  CANCELLED
  DISPUTED
}

enum CreditType {
  EARNED
  SPENT
  PURCHASED
  DONATED
  BONUS
  REFERRAL
  REFUND
}
